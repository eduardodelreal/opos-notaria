# Supabase — Project Settings > API
# Sin estas variables la app arranca en MODO LOCAL (todo en localStorage del navegador).
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional: nombre del bucket de Storage para los audios de los cantes.
VITE_SUPABASE_AUDIO_BUCKET=cantes
