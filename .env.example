# Clave de la API de Anthropic. Sin ella la app funciona entera,
# pero los modulos de IA (analisis de cantes, chat, plan, correccion
# de dictamenes) devuelven un aviso en vez de una respuesta.
ANTHROPIC_API_KEY=

# Opcional: modelo a usar. Por defecto claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Transcripcion del cante (opcional, y es OTRO proveedor).
#
# La API de Anthropic NO acepta audio: sus bloques de contenido son texto,
# imagenes y documentos (PDF y texto plano), y no hay endpoint de
# transcripcion. Comprobado contra la documentacion antes de escribir el
# codigo; ver docs/ia.md. Asi que la transcripcion sale de un servicio
# compatible con el dialecto POST /audio/transcriptions de OpenAI, que
# hablan tambien Groq, faster-whisper y whisper.cpp servidos en local.
#
# Sin esto se graba, se guarda y se reproduce igual; lo unico que no hay es
# transcripcion (y por tanto tampoco comparacion con el texto del tema),
# y la interfaz lo dice.
# ---------------------------------------------------------------------------
TRANSCRIPCION_API_KEY=
# Por defecto https://api.openai.com/v1
TRANSCRIPCION_URL=
# Por defecto whisper-1. En Groq, por ejemplo, whisper-large-v3.
TRANSCRIPCION_MODELO=

# ---------------------------------------------------------------------------
# Supabase (opcional). Sin estas dos variables la app arranca y funciona
# entera en local: el expediente vive en IndexedDB, como hasta ahora, y
# simplemente no aparece la opcion de iniciar sesion. Con ellas se activan
# las cuentas, que son la base para sincronizar entre dispositivos.
#
# Las dos se leen en el navegador, asi que Next las incrusta EN TIEMPO DE
# BUILD: en Netlify o Railway hay que declararlas antes de compilar, no solo
# en runtime.
#
# Estan en el panel de Supabase, en Project Settings -> API.
# ---------------------------------------------------------------------------

# URL del proyecto, del estilo https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave "anon" / publishable. Es PUBLICA POR DISENO: viaja al navegador de
# cualquiera que abra la app y no es un secreto. Quien protege los datos no
# es esta clave, sino las politicas RLS de la base de datos (db/schema.sql),
# que solo dejan a cada usuario ver y tocar sus propias filas.
#
# La que NO debe salir nunca de aqui es la "service_role": se salta RLS.
# En esta app no se usa en ningun sitio.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Reparto Netlify / Railway -------------------------------------------
# Las funciones de Netlify cortan a los 10-30 s e ignoran el maxDuration de
# Next; las respuestas del modelo tardan minutos. Solucion: el mismo build
# desplegado tambien en Railway (contenedor de larga vida) y esta variable
# apuntando alli, para que el navegador mande las llamadas de IA a Railway.
# Se incrusta en tiempo de compilacion: hay que declararla ANTES de construir.
# Dejala vacia en Railway y en local: entonces se llama al propio origen.
NEXT_PUBLIC_IA_URL=

# Dominios desde los que se sirve la app, separados por comas. Solo hace
# falta en el despliegue que atiende las rutas de IA (Railway), para que
# acepte las llamadas cross-origin del dominio de Netlify.
ORIGENES_PERMITIDOS=

# ---------------------------------------------------------------------------
# Avisos push (opcional). Sin estas variables la app funciona entera y el
# apartado de avisos simplemente no aparece, igual que pasa sin Supabase.
#
# Las claves VAPID son un par ECDSA P-256 que identifica a NUESTRO servidor
# ante los servicios push de Google, Mozilla y Apple. Se generan UNA sola vez
# y no se rotan salvo que se filtre la privada: al rotarlas, todas las
# suscripciones existentes dejan de servir y hay que volver a pedir permiso
# aparato por aparato.
#
#   npm run avisos:claves        (o: npx web-push generate-vapid-keys)
#
# Todo esto esta explicado con detalle en docs/avisos.md.
# ---------------------------------------------------------------------------

# La PUBLICA. Es publica por diseno: viaja al navegador dentro de cada
# suscripcion. Next la incrusta EN TIEMPO DE BUILD, asi que hay que declararla
# antes de compilar, tanto en Netlify como en Railway.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# LO QUE VIENE A CONTINUACION ES SOLO PARA EL CRON DE RAILWAY.
# Ninguna de estas tres variables debe existir en el entorno del sitio web
# (ni en Netlify ni en el servicio de Railway que sirve la app), y NINGUNA
# puede llamarse NEXT_PUBLIC_*: eso las meteria en el JavaScript que se
# descarga cualquiera que abra la web.
# ---------------------------------------------------------------------------

# La PRIVADA del par VAPID. Quien la tenga puede mandar notificaciones en
# nombre de esta app a cualquiera que este suscrito.
VAPID_PRIVATE_KEY=

# A quien avisa el servicio push si nuestros envios dan problemas. Un mailto:
# o una https://. Algunos servicios rechazan el envio si falta.
VAPID_SUBJECT=mailto:tu-correo@ejemplo.es

# La clave `service_role` de Supabase. SE SALTA LA RLS ENTERA: con ella se lee
# y se escribe el expediente de TODOS los opositores sin iniciar sesion. El
# cron la necesita porque decide avisos para todo el mundo. Solo aqui, nunca
# en el build de la app, nunca en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# URL del proyecto para el cron. Si no esta, se usa NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Ancho de la ventana de disparo, en minutos. TIENE QUE COINCIDIR con cada
# cuanto corre el cron: con un cron cada 15 minutos, 15.
AVISOS_VENTANA_MIN=15
